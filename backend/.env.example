PORT=5000
NODE_ENV=development

# Use DATABASE_URL for Render/cloud deployment
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# OR use individual vars for local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_crm
DB_USER=postgres
DB_PASSWORD=your_password

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Default Login Credentials (seeded by migrate)
# ─────────────────────────────────────────────
# Admin:     admin@company.com     / Admin@123
# Sales:     sales@company.com     / Sales@123
# Warehouse: warehouse@company.com / Warehouse@123
# Accounts:  accounts@company.com  / Accounts@123
# ─────────────────────────────────────────────
# Run: npm run db:migrate  to seed these users
